{
  "name": "gh-nibfin-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "astro sync && tsc -b && vite build && astro build",
    "typecheck": "astro sync && tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "screenshots": "astro sync && tsc -b && vite build --mode screenshots && astro build && playwright test --project chromium --project site",
    "sentry-sourcemaps": "sentry-cli sourcemaps inject dist-site && sentry-cli sourcemaps upload --release \"$GITHUB_SHA\" dist-site",
    "docs-screenshots": "astro sync && tsc -b && vite build --mode screenshots && astro build && playwright test --project docs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@astrojs/starlight": "^0.43.1",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@dagrejs/dagre": "^3.1.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@sentry/browser": "^11.19.0",
    "@xyflow/react": "^13.0.3",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "get-nonce": "^1.0.1",
    "lucide-react": "^1.80.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "1.65.1",
    "@sentry/cli": "^3.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
