# The embedded workflow templates render byte-identical output on every OS,
# so a Windows checkout must not convert them to CRLF.
/internal/templates/workflowfiles/workflows/*.yml text eol=lf
# The collaborator runner hook's files run on Linux runner hosts, and its test
# data is compared byte for byte.
/internal/runnerhook/files/** text eol=lf
/internal/runnerhook/testdata/** text eol=lf
# The host smoke test's stand-in runner scripts run in the Linux VM.
/internal/op/testdata/hostsmoke/** text eol=lf
